{
  "venvPath": "backend",
  "venv": "venv",
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/venv",
    "**/__pyrefly_virtual__"
  ],
  "extraPaths": [
    "backend",
    "backend/venv/Lib/site-packages"
  ],
  "pythonVersion": "3.14",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        ".",
        "venv/Lib/site-packages"
      ]
    }
  ]
}
