# CampuSentry Environment Configuration Template

# Flask Core Environment
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=false
SECRET_KEY=replace_with_a_secure_cryptographic_random_key_in_production

# Database Configuration (Single SQLite database)
DATABASE_URL=sqlite:///campus_helpdesk.db

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Settings (5 MB max)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads

# SLA & Daemon Monitor Configuration
SLA_MONITOR_INTERVAL_SECONDS=45
HIGH_SLA_HOURS=4
MEDIUM_SLA_HOURS=24
LOW_SLA_HOURS=72

# Session Cookie Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Official College Domain
OFFICIAL_COLLEGE_EMAIL_DOMAIN=acetcbe.edu.in
